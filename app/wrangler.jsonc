{
  // Scaffold for local reference. Deploy uses the Nitro-generated
  // config at .output/server/wrangler.json, via `bun run deploy`.
  "name": "qcl",
  "compatibility_date": "2026-11-07",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".output/server/index.mjs",
  "assets": {
    "directory": ".output/public",
  },
  // Public client config (same values baked into the web app). Used by
  // /api/leo to read the caller's library with their JWT.
  "vars": {
    "SUPABASE_URL": "https://mdytuysdombxyydqnsmj.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_pCfoSYyZSDDxvvnbmq_EHw_7BUhKzYm",
  },
  // /api/libros cache misses, /api/tapa, /api/genero and /api/leo, per client IP.
  "ratelimits": [
    {
      "name": "CATALOG_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 },
    },
    {
      "name": "GENRE_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 },
    },
    {
      "name": "TAPA_LIMIT",
      "namespace_id": "1003",
      // 120/min covers a whole library; cached hits do not spend the limit.
      "simple": { "limit": 120, "period": 60 },
    },
    {
      "name": "LEO_LIMIT",
      "namespace_id": "1004",
      "simple": { "limit": 15, "period": 60 },
    },
  ],
  // Workers Logs for request and error traces.
  "observability": { "enabled": true },
  // Workers AI: genre classifier and Qué leo (src/server/genre-ai.ts, leo-ai.ts).
  "ai": { "binding": "AI" },
}

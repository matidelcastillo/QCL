{
  // Scaffold for local reference. Deploy uses the Nitro-generated
  // config at .output/server/wrangler.json, via `bun run deploy`.
  "name": "qcl",
  "compatibility_date": "2026-11-07",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".output/server/index.mjs",
  "assets": {
    "directory": ".output/public",
  },
  // /api/libros cache misses and /api/genero calls, per client IP.
  "ratelimits": [
    {
      "name": "CATALOG_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 },
    },
    {
      "name": "GENRE_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
  // Workers AI: genre classifier (src/server/genre-ai.ts).
  "ai": { "binding": "AI" },
}
